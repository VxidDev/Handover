# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONTACT_ENCRYPTION_KEY=

# SQLite (default) or PostgreSQL URL
# DATABASE_URL=sqlite:///./data/handover.db
# DATABASE_URL=postgresql://user:password@localhost:5432/handover

# Token TTL in seconds (default: 7 days)
# TOKEN_TTL_SECONDS=604800

# Room token TTL in seconds (default: 15 minutes)
# ROOM_TOKEN_TTL_SECONDS=900

# Set to "true" to seed demo data on first start (development only)
SEED_DEMO_DATA=false

# "development" or "production"
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins, or "*" for all
CORS_ORIGINS=*

# Rate limit: max auth requests per minute per IP (default: 30)
# RATE_LIMIT_MAX=30

# SMTP settings for sending emails (password reset, etc.)
# Leave SMTP_HOST empty to disable email sending (tokens logged instead)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@example.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=noreply@handover.app
# SMTP_TLS=true

# Frontend URL used in email links (e.g. password reset)
# FRONTEND_URL=http://localhost:3000
