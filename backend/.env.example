# Copy to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_a_random_value

# Required. Fernet key for encrypting private contacts.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONTACT_ENCRYPTION_KEY=change_me_generate_a_fernet_key

DATABASE_URL=sqlite:///data/handover.db
ENVIRONMENT=development
CORS_ORIGINS=*

# Token lifetimes (seconds)
TOKEN_TTL_SECONDS=604800
ROOM_TOKEN_TTL_SECONDS=900

# Moderation strikes
WARNING_EXPIRY_DAYS=7
WARNING_BAN_THRESHOLD=10
WARNING_BAN_DURATION_DAYS=7

FRONTEND_URL=http://localhost:3000

# Optional integrations (leave empty for local dev)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_AUTH=

# Image moderation (Play Child Safety). Set at least one provider in production.
NSFW_THRESHOLD=0.85
NSFW_ENABLED=auto
HIVE_API_KEY=
GOOGLE_VISION_CREDENTIALS=
